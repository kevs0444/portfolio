# Primary Bop AI provider (Vercel: Type = Secret, Scope = Production & Preview)
GROQ_API_KEY=

# Optional: pin Groq to one available model instead of automatic routing (Vercel: Type = Config)
# GROQ_ROUTING=single
# GROQ_MODEL=openai/gpt-oss-20b

# Optional Google Gemini fallback when Groq is unavailable or rate-limited (Vercel: Type = Secret)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash

# Optional Cerebras fallback after Groq and Gemini (Vercel: Type = Secret)
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b

# Optional contact email overrides (defaults to markevinalcantara40@gmail.com)
# In Vercel, add server secrets to Preview and Production, then redeploy.
# EMAIL_PASS accepts Gmail's displayed app-password format with or without spaces. (Vercel: Type = Secret)
EMAIL_PASS=
# EMAIL_USER=markevinalcantara40@gmail.com
# CONTACT_TO_EMAIL=markevinalcantara40@gmail.com

# Redis (Live Visitors + distributed API rate limiting)
# Configure these in Vercel so limits are shared across all serverless instances.
# Vercel: UPSTASH_REDIS_REST_URL = Config, UPSTASH_REDIS_REST_TOKEN = Secret
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Site Configuration (Vercel: Type = Config, must not be Secret for NEXT_PUBLIC_ vars)
NEXT_PUBLIC_SITE_URL=https://mar-kevs.vercel.app

# Optional local asset sync overrides (defaults to D:\Job Related\Resume\... and D:\Job Related\Certificate)
# PORTFOLIO_RESUME_SOURCE=
# PORTFOLIO_CERTIFICATES_SOURCE=

