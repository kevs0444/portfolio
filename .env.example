# Primary Bop AI provider
GROQ_API_KEY=

# Optional: pin Groq to one available model instead of automatic routing
# GROQ_ROUTING=single
# GROQ_MODEL=openai/gpt-oss-20b

# Optional Google Gemini fallback when Groq is unavailable or rate-limited
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash

# Optional Cerebras fallback after Groq and Gemini
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b

# Optional contact email overrides (defaults to markevinalcantara40@gmail.com)
EMAIL_PASS=
# EMAIL_USER=markevinalcantara40@gmail.com
# CONTACT_TO_EMAIL=markevinalcantara40@gmail.com
